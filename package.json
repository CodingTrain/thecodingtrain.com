{
  "name": "the-coding-train",
  "version": "1.0.0",
  "private": true,
  "description": "The Coding Train",
  "author": "The Coding Train",
  "license": "MIT",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "dev": "gatsby develop -H 0.0.0.0",
    "build": "gatsby build --verbose",
    "build-ci": "node node-scripts/generate-challenges-redirects && node node-scripts/generate-youtube-redirects && npm run tags-transforms && npm run build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "testv": "jest --verbose",
    "yt-desc": "node node-scripts/yt-description.mjs",
    "update-yt": "node node-scripts/update-yt.mjs",
    "tags-transforms": "node node-scripts/tags-transforms",
    "formatc": "prettier \"content/**/*.json\" --write"
  },
  "dependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@mdx-js/react": "^2.3.0",
    "@octokit/core": "^7.0.7",
    "classnames": "^2.5.1",
    "clipboardy": "^5.3.2",
    "gatsby": "^5.16.1",
    "gatsby-core-utils": "^4.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-mdx": "^5.16.0",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "postcss": "^8.5.26",
    "postcss-calc": "^10.1.1",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.1",
    "postcss-normalize": "^13.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-youtube": "^10.1.0",
    "remark-gfm": "^3.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "glob": "^13.0.6",
    "google-auth-library": "^11.0.1",
    "googleapis": "^174.0.1",
    "inquirer": "^14.0.2",
    "jest": "^30.4.2",
    "lodash": "^4.18.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "svgo": "^4.0.2"
  },
  "allowScripts": {
    "sharp": true
  }
}
